# ============================================================================
# .env.copia — PLANTILLA versionada (SIN secretos). Copiala a .env y rellena.
# ============================================================================
#
#   cp .env.copia .env          # Linux / macOS
#   Copy-Item .env.copia .env   # Windows / PowerShell
#
# El fichero .env real esta en .gitignore y NUNCA debe subirse al repositorio.
# Procedimiento completo para obtener estos valores: doc/guia-paso-a-paso.md
# Requisitos de tenant: doc/prerequisitos.md
#
# ⚠️ Si un secreto se expone alguna vez, rotalo:
#    az ad app credential reset --id <APP_ID> --display-name "Purview SDK Secret" --years 2
# ----------------------------------------------------------------------------

# ===== Microsoft Entra / Azure =====
# AZURE_TENANT_ID: id del directorio (Tenant ID).
#   Obtenerlo:  az account show --query tenantId -o tsv
AZURE_TENANT_ID=<TENANT_ID>
# AZURE_SUBSCRIPTION_ID: suscripcion de Azure (informativo; para billing pay-as-you-go).
#   Obtenerlo:  az account show --query id -o tsv
AZURE_SUBSCRIPTION_ID=<SUBSCRIPTION_ID>

# ===== App Registration (cliente del Purview SDK) =====
# PURVIEW_CLIENT_ID: appId (Client ID) de la App Registration. Guia paso 4.
#   Autentica Y es el valor de Location de la politica DLP.
PURVIEW_CLIENT_ID=<APP_ID>
# PURVIEW_CLIENT_SECRET: secreto de cliente. Guia paso 5 (az ad app credential reset).
#   NO lo escribas en la plantilla; ponlo solo en el .env real (o usa Key Vault).
PURVIEW_CLIENT_SECRET=<CLIENT_SECRET>
# Identificadores de referencia (no autentican). Guia pasos 4 y 7.
PURVIEW_APP_OBJECT_ID=<APP_OBJECT_ID>
PURVIEW_SP_OBJECT_ID=<SP_OBJECT_ID>

# ===== Identidad de la app protegida (protectedAppMetadata / PurviewAppLocation) =====
# Nombre y version que el cliente declara ante Purview.
PURVIEW_APP_NAME=Demo-Purview-sdk
PURVIEW_APP_VERSION=1.0
# PURVIEW_APP_LOCATION_VALUE: debe COINCIDIR con el Location de la politica DLP (= PURVIEW_CLIENT_ID).
#   Guia pasos 10-11.
PURVIEW_APP_LOCATION_TYPE=Application
PURVIEW_APP_LOCATION_VALUE=<APP_ID>

# ===== Microsoft Graph =====
# GRAPH_BASE_URL: endpoint + version de la API (las Purview APIs viven en /beta).
GRAPH_BASE_URL=https://graph.microsoft.com/beta
# GRAPH_SCOPE: ambito del token OAuth (client credentials usa siempre /.default).
GRAPH_SCOPE=https://graph.microsoft.com/.default

# ===== Referencia DLP (informativo) =====
DLP_POLICY_NAME=DLP-Demo-Purview-SDK
DLP_RULE_NAME=Block Credit Cards Purview SDK

# ============================================================================
# NOTA: el user_id (object id del usuario final) NO se define aqui.
# Es un parametro OBLIGATORIO en tiempo de ejecucion (se pasa a los scripts).
#   Obtener el object id de un UPN:  az ad user show --id <UPN> --query id -o tsv
# En la Azure Function final se extraera del claim 'oid' del token del usuario.
# ============================================================================
